        {/* Swipeable Carousel */}
        <div className="relative max-w-4xl mx-auto mb-12">
          <div className="relative h-[420px] md:h-[380px]" ref={constraintsRef}>
            <AnimatePresence mode="wait" custom={currentIndex}>
              <motion.div
                key={currentIndex}
                className="absolute inset-0"
                initial={{ opacity: 0, x: 300, scale: 0.9 }}
                animate={{ opacity: 1, x: 0, scale: 1 }}
                exit={{ opacity: 0, x: -300, scale: 0.9 }}
                transition={{ type: "spring", stiffness: 300, damping: 30 }}
                drag="x"
                dragConstraints={{ left: 0, right: 0 }}
                dragElastic={0.2}
                onDragEnd={handleDragEnd}
              >
                <div className="backdrop-blur-2xl bg-white/95 rounded-3xl p-8 md:p-10 border border-neutral-200/50 shadow-2xl h-full flex flex-col relative overflow-hidden cursor-grab active:cursor-grabbing">
                  {/* Top gradient accent */}
                  <motion.div
                    className={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r ${currentTestimonial.color}`}
